# Public Supabase project URL (Dashboard -> Project Settings -> Data API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public Supabase publishable key (read-only browser queries & Realtime; NEVER use service_role or sb_secret_*)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# Server-only Supabase service_role key (used strictly inside Next.js API routes; NEVER prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Server-only HMAC secret (at least 16 random chars) for session cookies & per-thread anonymous IDs
AUTH_SESSION_SECRET=replace_with_at_least_32_random_characters

# Optional legacy fallback if your project only has a legacy anon JWT key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_legacy_anon_key
